# .claudeignore

# 依存関係ディレクトリ
node_modules/
vendor/
.venv/
env/
venv/
.yarn/

# ビルド出力
dist/
build/
.next/
out/
coverage/
.vercel/
*.tsbuildinfo

# バージョン管理
.git/
.gitignore
.gitattributes

# ロックファイル（これだけで数千トークン削減）
*.lock
package-lock.json
yarn.lock
Gemfile.lock
Cargo.lock
requirements.lock
poetry.lock

# ログ・キャッシュ
*.log
.cache/
.tmp/
tmp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS関連
.DS_Store
Thumbs.db
*.swp
*.swo
*.pem

# 環境変数
.env*

# 型定義ファイル
next-env.d.ts

# Gemini CLI 関連
hist/
tasks/

# プロジェクトメモ
requirements/

# 画像バイナリ
public/images/
